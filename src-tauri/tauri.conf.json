{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse Desktop Mascot",
  "version": "1.1.1",
  "identifier": "works.mowthow.muse.gadgets",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Muse Desktop Mascot",
        "label": "main",
        "width": 420,
        "height": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "assets/avatars/setting.json": "avatars/setting.json",
      "assets/avatars/plugin/quotes.json": "avatars/plugin/quotes.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"]
      }
    }
  }
}
