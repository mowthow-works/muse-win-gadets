{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse Desktop Gadget",
  "version": "0.8.0",
  "identifier": "works.mowthow.muse.gadgets",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Muse Desktop Gadget",
        "label": "main",
        "width": 420,
        "height": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
