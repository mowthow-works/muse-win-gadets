{
  "name": "muse-desktop-mascot",
  "private": true,
  "version": "1.1.4",
  "description": "Windows Desktop Mascot for Muse AI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:installer": "tauri build",
    "tauri": "tauri",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:unit && npm run test:e2e && npm run test:rust"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2",
    "jsdom": "^31.0.0",
    "vitest": "^5.1.0"
  }
}
